+++ b/src/S04_Tests/test_data_factory_v02_integration.py
@@ -0,0 +1,104 @@
+from __future__ import annotations
+
+import tempfile
+import unittest
+from pathlib import Path
+
+import h5py
+import numpy as np
+import pandas as pd
+
+from S03_Scripts.validate_data_contract import build_contract_report
+from phm_agent_benchmark import FoundationRuntime, PhmDataFactoryAdapter
+from phm_agent_benchmark.artifacts import ArtifactKind, WindowRequest
+from phm_data_factory import connect_agent
+
+
+class DataFactoryV02IntegrationTest(unittest.TestCase):
+    def test_real_provider_surface_is_executable_and_hidden_label_safe(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            metadata = root / "metadata.csv"
+            signals = root / "signals.h5"
+            pd.DataFrame(
+                [
+                    {
+                        "Id": "visible",
+                        "Dataset_id": 1,
+                        "Name": "fixture",
+                        "Visiable": 1,
+                        "Label": 9,
+                        "Fault_level": 2,
+                        "Domain_id": 0,
+                        "Sample_rate": 8.0,
+                        "Sample_lenth": 8,
+                        "Channel": 1,
+                        "Fault_Diagnosis": 1,
+                    },
+                    {
+                        "Id": "hidden",
+                        "Dataset_id": 1,
+                        "Name": "fixture",
+                        "Visiable": 0,
+                        "Label": 4,
+                        "Domain_id": 0,
+                        "Sample_lenth": 8,
+                        "Channel": 1,
+                    },
+                ]
+            ).to_csv(metadata, index=False)
+            with h5py.File(signals, "w") as handle:
+                handle.create_dataset("visible", data=np.arange(8)[:, None])
+                handle.create_dataset("hidden", data=np.arange(8)[:, None])
+
+            tools = connect_agent(
+                {
+                    "backend": "local",
+                    "metadata_path": str(metadata),
+                    "signal_path": str(signals),
+                },
+                profile="benchmark_public",
+                dataset_digest="sha256:integration-fixture",
+            )
+            with tools:
+                manifest = tools.manifest()
+                report = build_contract_report(manifest, "provider-revision")
+                self.assertEqual(
+                    report["status"], "executable_for_continuous_offline"
+                )
+                search = tools.search_samples(dataset_id=1, limit=10)
+                self.assertEqual([item["sample_id"] for item in search], ["visible"])
+                self.assertNotIn("label", search[0])
+                described = tools.get_sample_metadata("visible")
+                self.assertNotIn("label", described)
+                with self.assertRaises(KeyError):
+                    tools.get_sample_metadata("hidden")
+
+                adapter = PhmDataFactoryAdapter(tools)
+                self.assertEqual(
+                    adapter.describe_sample("visible")["sample_id"], "visible"
+                )
+                runtime = FoundationRuntime(adapter)
+                artifact = runtime.read_window(
+                    WindowRequest(
+                        sample_id="visible",
+                        start=0,
+                        end=8,
+                        channels=(0,),
+                        max_points=8,
+                        kind=ArtifactKind.CONTINUOUS_SERIES,
+                        unit=None,
+                    )
+                )
+                public = artifact.to_dict()
+                self.assertNotIn("values", public)
+                rms = runtime.execute_operator("rms", artifact.ref).to_dict()
+                self.assertIn("feature_results", rms["metadata"])
+                self.assertEqual(
+                    tools.get_signal_statistics("visible", end=8)["sample_id"],
+                    "visible",
+                )
+
+
+if __name__ == "__main__":
+    unittest.main()
